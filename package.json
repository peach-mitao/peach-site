{
  "name": "peach-site",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peach-mitao/peach-site.git"
  },
  "scripts": {
    "predev": "npm run browser:build",
    "dev": "cf dev",
    "predev:edit": "npm run browser:build",
    "browser:build": "node scripts/build_browser.ts",
    "dev:edit": "node scripts/serve.ts",
    "dev:behavior": "node scripts/preview_behavior.ts",
    "behavior:check": "node scripts/check_behavior.ts",
    "behavior:capture": "node scripts/capture_site_behavior.ts",
    "edit:sync": "node scripts/sync_copy_editor.ts",
    "i18n": "node scripts/build_i18n.ts",
    "prebuild": "npm run browser:build",
    "build": "cf build",
    "assets:fetch": "node scripts/fetch_assets.ts",
    "cache:sync": "node scripts/cache_headers.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json && node scripts/check.ts",
    "precheck": "npm run browser:build && cf workers types",
    "check:deploy": "cf deploy --dry-run",
    "precheck:deploy": "npm run browser:build",
    "verify": "node scripts/check_publish.ts",
    "verify:typography": "node scripts/check_typography.ts",
    "verify:mobile": "node scripts/check_mobile.ts",
    "verify:downloads": "node scripts/check_downloads.ts",
    "verify:analytics": "node scripts/check_analytics.ts",
    "verify:interface": "node scripts/check_interface.ts",
    "verify:locale": "node scripts/check_locale.ts",
    "verify:support": "node scripts/check_support.ts",
    "verify:region": "node scripts/check_region.ts",
    "verify:download-cache": "node scripts/check_download_cache.ts",
    "verify:preferences": "node scripts/check_preferences.ts",
    "verify:cache": "node scripts/check_cache.ts",
    "analytics": "node scripts/analytics_report.ts",
    "capture:desktop": "node scripts/capture_compact_desktop.ts && node scripts/optimize_compact_desktop.ts",
    "predeploy": "npm run browser:build && npm run behavior:check",
    "deploy": "cf deploy",
    "pretest": "npm run browser:build",
    "test": "node --test tests/*.test.ts",
    "pretest:browser": "npm run browser:build",
    "test:browser": "node scripts/test_browser.ts",
    "pretest:behavior": "npm run browser:build",
    "test:behavior": "node scripts/check_behavior_browser.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.18",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.15.0",
    "@phosphor-icons/react": "2.1.10",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
